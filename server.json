{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bartekrutkowski/watchgoose-mcp",
  "title": "Watchgoose",
  "description": "Monitor cron jobs and recurring work through a project-scoped Watchgoose connection.",
  "websiteUrl": "https://watchgoose.com/docs/mcp/",
  "repository": {
    "url": "https://github.com/bartekrutkowski/watchgoose-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "icons": [
    {
      "src": "https://watchgoose.com/static/img/watchgoose-mcp.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://watchgoose.com/static/img/watchgoose-icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "watchgoose-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WATCHGOOSE_API_KEY",
          "description": "Project-scoped Watchgoose API key: hcr_ read-only or hcw_ read-write.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.watchgoose.com/mcp"
    }
  ]
}
